---
// src/components/Contact.astro
---

<section id="contato" class="w-full h-dvh flex flex-col justify-center relative z-10 pointer-events-auto snap-start snap-always shrink-0 overflow-hidden">
  
  <div class="w-full h-full overflow-y-auto px-6 md:px-16 lg:px-24 py-20 flex items-center">
    
    <div class="max-w-7xl w-full mx-auto flex flex-col items-center md:items-start text-center md:text-left">
      
      <h2 class="text-3xl md:text-4xl font-bold text-teal-400 font-mono tracking-tight mb-6">
        Contato
      </h2>
      
      <p class="text-gray-400 font-mono text-base md:text-lg mb-14 max-w-2xl mx-auto md:mx-0">
        Entre em contato através das minhas redes sociais:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl mx-auto md:mx-0">
        
        <!-- E-mail -->
        <a href="mailto:contato.thalyssondel@gmail.com" target="_blank" rel="noopener noreferrer" class="relative flex flex-col items-center md:items-start p-8 bg-[#0a0a0a]/80 backdrop-blur-md border border-gray-800 rounded-2xl transition-all duration-500 hover:-translate-y-2 hover:border-teal-500/50 hover:shadow-[0_0_30px_rgba(45,212,191,0.15)] group overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-b from-teal-500/0 to-teal-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <div class="mb-5 p-4 rounded-full bg-gray-900/50 border border-gray-800 group-hover:border-teal-500/30 group-hover:bg-teal-500/10 transition-colors duration-500 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400 group-hover:text-teal-400 group-hover:scale-110 transition-all duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>

          <span class="text-white font-bold font-mono text-xl mb-2 group-hover:text-teal-400 transition-colors duration-500 z-10">E-mail</span>
          <span class="text-gray-500 font-mono text-sm group-hover:text-gray-300 transition-colors duration-500 z-10">contato.thalyssondel@gmail.com</span>
        </a>

        <!-- GitHub -->
        <a href="https://github.com/thalyssondelano" target="_blank" rel="noopener noreferrer" class="relative flex flex-col items-center md:items-start p-8 bg-[#0a0a0a]/80 backdrop-blur-md border border-gray-800 rounded-2xl transition-all duration-500 hover:-translate-y-2 hover:border-gray-400/50 hover:shadow-[0_0_30px_rgba(255,255,255,0.05)] group overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-b from-gray-500/0 to-gray-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <div class="mb-5 p-4 rounded-full bg-gray-900/50 border border-gray-800 group-hover:border-gray-400/30 group-hover:bg-gray-400/10 transition-colors duration-500 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400 group-hover:text-white group-hover:scale-110 transition-all duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </div>

          <span class="text-white font-bold font-mono text-xl mb-2 group-hover:text-white transition-colors duration-500 z-10">GitHub</span>
          <span class="text-gray-500 font-mono text-sm group-hover:text-gray-300 transition-colors duration-500 z-10">thalyssondelano</span>
        </a>

        <!-- Instagram -->
        <a href="https://instagram.com/thalyssondelano" target="_blank" rel="noopener noreferrer" class="relative flex flex-col items-center md:items-start p-8 bg-[#0a0a0a]/80 backdrop-blur-md border border-gray-800 rounded-2xl transition-all duration-500 hover:-translate-y-2 hover:border-pink-500/50 hover:shadow-[0_0_30px_rgba(225,48,108,0.15)] group overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-b from-pink-500/0 to-pink-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <div class="mb-5 p-4 rounded-full bg-gray-900/50 border border-gray-800 group-hover:border-pink-500/30 group-hover:bg-pink-500/10 transition-colors duration-500 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400 group-hover:text-[#E1306C] group-hover:scale-110 transition-all duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </div>

          <span class="text-white font-bold font-mono text-xl mb-2 group-hover:text-[#E1306C] transition-colors duration-500 z-10">Instagram</span>
          <span class="text-gray-500 font-mono text-sm group-hover:text-gray-300 transition-colors duration-500 z-10">thalyssondelano</span>
        </a>

      </div>
    </div>
  </div>
</section>