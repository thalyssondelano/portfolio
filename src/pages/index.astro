---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <div id="tsparticles" class="fixed inset-0 z-0 bg-[#050505]"></div>

  <div class="relative z-10 h-dvh flex flex-col w-full pointer-events-none snap-start snap-always shrink-0">
    
    <header class="w-full py-8 px-6 md:px-16 lg:px-24 flex justify-start items-center pointer-events-auto">
      <div class="text-2xl font-bold tracking-tighter text-white font-mono">
        Thalysson<span class="text-gray-500">.</span>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="flex-1 flex flex-col justify-center px-6 md:px-16 lg:px-24 pb-20 pointer-events-auto">
  
      <div class="space-y-5 max-w-5xl container-animado w-full">
        
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-bold text-white tracking-tight leading-[1.3] font-mono text-center md:text-left">
          <span class="block md:inline">Olá, eu sou </span>
          <span class="block md:inline text-gray-400">Thalysson Delano,</span>
          <span class="block mt-4 md:mt-2">Desenvolvedor Full Stack.</span>
        </h1>
        
        <p class="text-base md:text-lg text-gray-400 font-mono mt-6 md:mt-2 text-center md:text-left max-w-lg mx-auto md:mx-0">
          Projetando soluções tecnológicas inovadoras para conectar e transformar.
        </p>

        <div class="pt-10 md:pt-6 flex justify-center md:justify-start">
          <a href="#sobre" class="inline-flex items-center justify-center w-12 h-12 bg-white text-black hover:bg-gray-300 transition-colors cursor-pointer group" aria-label="Descer para Sobre Mim">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
        
      </div>

    </main>
  </div>

  <About />

  <Contact />
  
</Layout>

<script is:inline src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2.0.6/tsparticles.slim.bundle.min.js"></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    tsParticles.load("tsparticles", {
      fpsLimit: 60,
      interactivity: {
        events: {
          onHover: {
            enable: true,
            mode: "grab", 
          },
          resize: true,
        },
        modes: {
          grab: {
            distance: 180,
            links: {
              opacity: 0.5,
              color: "#2dd4bf"
            },
          },
        },
      },
      particles: {
        color: {
          value: ["#ffffff", "#2dd4bf", "#4b5563"],
        },
        links: {
          color: "#4b5563",
          distance: 150,
          enable: true, 
          opacity: 0.2,
          width: 1,
        },
        move: {
          direction: "none",
          enable: true,
          outModes: {
            default: "bounce", 
          },
          random: false,
          speed: 0.8, 
          straight: false,
        },
        number: {
          density: {
            enable: true,
            area: 800,
          },
          value: 60, 
        },
        opacity: {
          value: 0.4,
        },
        shape: {
          type: "circle",
        },
        size: {
          value: { min: 1, max: 3 }, 
        },
      },
      detectRetina: true,
    });
  });
</script>

<style>
  .container-animado {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out forwards;
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>